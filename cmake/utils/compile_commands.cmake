macro(enable_compile_commands)
  set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
  set(_cc_db "${CMAKE_BINARY_DIR}/compile_commands.json")
  set(_cc_link "${CMAKE_SOURCE_DIR}/compile_commands.json")
  if(IS_SYMLINK "${_cc_link}")
    file(REMOVE "${_cc_link}")
  endif()
  if(NOT EXISTS "${_cc_link}")
    file(CREATE_LINK "${_cc_db}" "${_cc_link}" SYMBOLIC RESULT _cc_result)
    if(DEFINED _cc_result AND NOT _cc_result STREQUAL "0" AND NOT _cc_result STREQUAL "")
      message(WARNING "compile_commands.json symlink not created: ${_cc_result}")
    endif()
  endif()
endmacro()
